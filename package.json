{
  "name": "user-management",
  "version": "1.0.0",
  "private": true,
  "description": "Angular user management front end (Application 2), with a lightweight mock REST API for development",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "mock-api": "json-server --watch mock/db.json --port 3000 --middlewares mock/middlewares/server-fields.js",
    "mock-api:reset": "node -e \"require('node:fs').copyFileSync('mock/db.seed.json', 'mock/db.json')\"",
    "dev": "concurrently -k -n mock-api,angular -c magenta,cyan \"npm:mock-api\" \"npm:start\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/forms": "^21.2.24",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.24",
    "@angular/router": "^21.2.24",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.24",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.1",
    "json-server": "^0.17.4",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  }
}
